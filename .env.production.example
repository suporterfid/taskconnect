APP_NAME=TaskConnect
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://tasks.yourdomain.com
APP_VERSION=1.3.0

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u123456789_shared_db
DB_USERNAME=u123456789_dbuser
DB_PASSWORD=YOUR_STRONG_HOSTINGER_DB_PASSWORD
DB_PREFIX=tc_

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=tasks.yourdomain.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=tasks.yourdomain.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=YOUR_MAIL_PASSWORD
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

SCHEDULER_CLAIM_BATCH=20
SCHEDULER_RETRY_BATCH=20
SCHEDULER_CLAIM_TTL_MINUTES=10
SCHEDULER_TARGET_DURATION_SECONDS=45
SCHEDULER_BUDGET_SAFETY_MARGIN_SECONDS=5
SCHEDULER_CLAIM_CHUNK=5
SCHEDULER_FAILURE_EMAILS_ENABLED=true
SCHEDULER_FAILURE_WEBHOOKS_ENABLED=true
SCHEDULER_COALESCE_WINDOW_SECONDS=60
SCHEDULER_FAIRNESS_WORKSPACE_WEIGHT=1
SCHEDULER_FAIRNESS_MODE=wfq
SCHEDULER_SUBMIT_RATE_LIMIT_PER_MINUTE=60
SCHEDULER_SUBMIT_RATE_LIMIT_WINDOW_SECONDS=60
SCHEDULER_AUDIT_CLAIMS=true
SCHEDULER_AUDIT_DELIVERIES=true

OUTBOUND_CONNECT_TIMEOUT=5
OUTBOUND_TOTAL_TIMEOUT=15
OUTBOUND_RESPONSE_BODY_LIMIT=65536
OUTBOUND_REQUEST_BODY_LIMIT=65536
OUTBOUND_REDIRECT_LIMIT=3
OUTBOUND_ALLOWED_PORTS=80,443
OUTBOUND_ALLOW_HTTP=false
OUTBOUND_USER_AGENT=OpenHttpScheduler/1.1

RETENTION_PAYLOAD_SNAPSHOTS_DAYS=30
RETENTION_ATTEMPT_METADATA_DAYS=180
RETENTION_RUN_SUMMARY_DAYS=365
RETENTION_AUDIT_LOGS_DAYS=365

GRANDPASSON_OUTBOUND_ENABLED=false
GRANDPASSON_INBOUND_ENABLED=false
GRANDPASSON_BASE_URL=https://sso.yourdomain.com
